# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Analytics only loads when this is set AND the build is production
# (npm run build), so local `npm run dev` never sends real traffic.
#
# For local testing: copy this file to .env.local and fill in your ID.
# For production (Netlify): set this as a build environment variable in
# Site settings > Environment variables — it must be present at BUILD
# time since this is a static export with no server to read env vars at
# request time.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Apps Script Web App URL for the contact form (ends in /exec).
# See README.md "Contact Form Setup" for how to create this.
# This is not a secret (it's called directly from the browser), but the
# env var keeps it out of the source and easy to change without a code edit.
NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=
